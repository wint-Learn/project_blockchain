# Backend server port
PORT=3000
NODE_ENV=development

# PostgreSQL connection string
DB_CONNECTION_STRING=postgres://postgres:1@localhost:5432/identity_db

# RPC Polygon Amoy (khuyến nghị dùng Alchemy)
# Ví dụ: https://polygon-amoy.g.alchemy.com/v2/ALCHEMY_API_KEY
POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/VXtKCaKEODUbOIx67NJvQ

# Ganache Local (for development)
LOCAL_RPC_URL=http://127.0.0.1:8545
# Private key từ Ganache account (0) - có 1000 ETH
# (mnemonic: "test test test test test test test test test test test junk")
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Admin Wallet Private Keys (dùng để ký blockchain transactions khi approve services)
# Admin ID 1 (username: admin) → Ganache Account #0
ADMIN_WALLET_PRIVATE_KEY_1=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Sau khi deploy smart contract ở thư mục blockchain (xem DEPLOYED_CONTRACTS.md)
# Ganache local contract (mỗi lần reset Ganache cần re-deploy và update địa chỉ này)
CONTRACT_ADDRESS=0x7a2088a1bFc9d81c55368AE168C2C02570cB814F

# ServiceRegistry contract address (Phase 2 - Dịch vụ công)
SERVICE_CONTRACT_ADDRESS=0x09635F643e140090A9A8Dcd712eD6285858ceBef

# Encryption key cho CCCD metadata (32 bytes hex = 64 chars)
# Generate mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456

# CORS: Danh sách origins được phép truy cập API ([,])
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

